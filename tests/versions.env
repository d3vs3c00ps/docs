# Last upstream Kaniko release; the project was archived in June 2025.
KANIKO_VERSION=v1.23.2
HELMFILE_VERSION=v1.8.4
CERT_MANAGER_CHART=v1.21.3
KYVERNO_CHART=3.9.2
BITNAMI_REDIS_CHART=28.3.12
