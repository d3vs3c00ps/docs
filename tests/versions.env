K0S_VERSION=v1.37.2+k0s.1
K0SCTL_VERSION=v0.33.1
K3S_IMAGE=rancher/k3s:v1.37.0-k3s1
KUBECTL_VERSION=v1.37.1
CILIUM_VERSION=1.20.0
K9S_VERSION=v0.51.0
STERN_VERSION=v1.35.0
TILT_VERSION=v0.37.8
