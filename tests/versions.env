# Pinned tool versions for the note tests. One source for the devcontainer, the
# Makefile and CI. Plain KEY=value lines, so both make and bash can read them.

KIND_VERSION=v0.33.0
# kind requires the digest: a tag alone may not match an image built for this release.
KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5
CLOUD_PROVIDER_KIND_VERSION=v0.11.1
K3D_VERSION=v5.9.0
K3S_IMAGE=rancher/k3s:v1.37.0-k3s1
KUBECTL_VERSION=v1.37.1
HELM_VERSION=v4.3.0
SHELLCHECK_VERSION=v0.11.0
TASK_VERSION=v3.54.0

# Observability notes (content/observability, kubernetes/observability/metrology).
# Images are multi-arch (amd64, arm64). Helm charts from prometheus-community and
# kubernetes-sigs.
PROMETHEUS_VERSION=v3.15.1
ALERTMANAGER_VERSION=v0.34.2
NODE_EXPORTER_VERSION=v1.12.1
GRAFANA_VERSION=13.3.0
KUBE_PROMETHEUS_STACK_CHART=92.18.0
METRICS_SERVER_CHART=3.14.0
