# Observability notes (content/observability, kubernetes/observability/metrology).
# Images are multi-arch (amd64, arm64). Helm charts from prometheus-community and
# kubernetes-sigs.
PROMETHEUS_VERSION=v3.15.1
ALERTMANAGER_VERSION=v0.34.2
NODE_EXPORTER_VERSION=v1.12.1
GRAFANA_VERSION=13.3.0
KUBE_PROMETHEUS_STACK_CHART=92.18.0
METRICS_SERVER_CHART=3.14.0
PROMETHEUS_CHART=29.47.2
PROMETHEUS_ADAPTER_CHART=5.4.2

# Ansible notes (content/automation/ansible): the ansible-systemd env, from PyPI.
ANSIBLE_VERSION=15.0.0
ANSIBLE_LINT_VERSION=26.11.0
MOLECULE_VERSION=26.11.0
# ai/ notes: llama.cpp is built from this tag; the tiny GGUF model is pinned by commit.
# Not v1.0.0: on 2026-11-23 its source build failed, as the web UI assets it downloads
# had changed upstream (missing bundle[hash].js). b12647 builds.
LLAMA_CPP_VERSION=b12647
TINY_GGUF_REPO=bartowski/SmolLM2-135M-Instruct-GGUF
TINY_GGUF_FILE=SmolLM2-135M-Instruct-Q4_K_M.gguf
TINY_GGUF_REVISION=09816acd5d99df7be770d85ea30822623dab342c
LLAMA_SWAP_VERSION=275
# ai/mcp: the MCP SDKs the note's servers are built with.
MCP_PY_VERSION=2.3.0
MCP_GO_SDK_VERSION=v1.8.0
MCP_GO_VERSION=v1.6.0
NODEJS_VERSION=v24.22.3
# linux/desktop/sway/nixos: home-manager, pinned to a commit of its release-26.05 branch.
HOME_MANAGER_REV=6480d7d8533b88c78cc6dcda395ab89cd546e450
# ai/strands-agents
STRANDS_VERSION=1.65.0
STRANDS_TOOLS_VERSION=0.9.0
# ai/pi
PI_VERSION=1.6.0
# ai/open-webui: the image tag (multi-arch).
OPEN_WEBUI_VERSION=0.13.4
# ai/prompt-optimization: the skills CLI behind `npx skills add`.
SKILLS_CLI_VERSION=1.9.0
# dev/gherkin, dev/bdd-with-pytest: the official Gherkin parser.
GHERKIN_VERSION=29.0.0
# dev/bdd-with-pytest
PYTEST_VERSION=8.3.5
PYTEST_ORDER_VERSION=1.3.0
PYTEST_BDD_VERSION=8.1.0
# dev/local-aws-emulation: the AWS CLI and Terraform, run as containers.
