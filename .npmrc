engine-strict=true
legacy-peer-deps=true

# npm 11 stopped running package install scripts unprompted. Quartz depends on
# esbuild and sharp, which use theirs to fetch platform-specific binaries — without
# them `npx quartz build` fails, and it fails *after* `npm ci` appears to succeed,
# which is a confusing place to discover it.
#
# This is a real reduction in supply-chain protection: any dependency's install
# script will now run. It is set here because the build happens in a container
# (see .devcontainer/) and in CI, not on a workstation. If you would rather approve
# them case by case, delete this line and run `npm approve-scripts` instead.
allow-scripts=true
